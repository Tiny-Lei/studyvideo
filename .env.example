# StudyVideo 环境变量示例
# 复制为 .env 后修改，run.sh 会自动加载

# 监听地址
HTTP_ADDR=:8080

# MySQL 连接串（生产环境请改成强密码）
DB_DSN=studyvideo:studyvideo123@tcp(127.0.0.1:3306)/studyvideo?parseTime=true&charset=utf8mb4&loc=Local&timeout=5s

# 管理后台密码（必须修改）
ADMIN_PASSWORD=change-me

# 登录 Cookie 签名密钥（建议 32 位随机字符串，生成：openssl rand -hex 32）
SESSION_SECRET=please-change-to-a-random-secret

# 反向代理信任策略：auto / true / false
TRUST_PROXY=auto

# 全站 HTTPS 时设为 true
COOKIE_SECURE=false

# ------- 风控 -------
DAILY_VIDEO_LIMIT=800
DAILY_TOTAL_LIMIT=8000
BURST_VIDEO_LIMIT=20
BURST_TOTAL_LIMIT=120
BURST_WINDOW_SECONDS=10
BLOCK_MINUTES=30

# ------- 后台登录保护 -------
# 单 IP 限制：窗口内允许的登录尝试次数
LOGIN_ATTEMPTS=10
LOGIN_WINDOW_SECONDS=600
# 全站限制（防分布式多 IP 爆破）：窗口内累计失败达到阈值后锁定全站登录
# 设为 0 可禁用；触发时会记录日志并通过 ALERT_WEBHOOK_URL 告警
LOGIN_GLOBAL_LIMIT=30
LOGIN_GLOBAL_WINDOW_SECONDS=900
LOGIN_LOCKOUT_SECONDS=1800

# ------- 链接健康检查 -------
CHECK_INTERVAL_MINUTES=360
CHECK_ON_START=true
CHECK_TIMEOUT_SECONDS=15
CHECK_WORKERS=6

# 可选：失效/风控告警 Webhook（企业微信/钉钉群机器人，text 消息格式）
ALERT_WEBHOOK_URL=

# ------- 配套资料（PDF）本地存储 -------
# 资料文件存储目录（相对路径基于启动目录；请确保运行用户有读写权限并纳入备份）
DATA_DIR=./data
# 单个 PDF（视频配套资料）大小上限（MB）
MAX_PDF_SIZE_MB=50
# 资料区单个文件大小上限（MB），资料区支持 PDF/Markdown/Office 文档等
MAX_MATERIAL_SIZE_MB=100

# ------- 访问/观看统计 -------
# 明细保留天数（按天清理，0 = 永久保留；仅在需要压缩数据量时调小）
STATS_KEEP_DAYS=730

# ------- 日志 -------
# 级别：debug / info / warn / error
LOG_LEVEL=info
# 格式：text（人读）/ json（便于日志采集）
LOG_FORMAT=text
